{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/industry-encyclopedia.schema.json",
  "title": "中国大陆应届生求职行业百科 v1.6.1",
  "type": "object",
  "required": [
    "文档元数据",
    "治理配置",
    "枚举字典",
    "来源注册表",
    "行业索引",
    "行业词条"
  ],
  "properties": {
    "文档元数据": {
      "type": "object",
      "required": ["文档名称", "版本", "发布日期", "适用人群", "schema_ref", "说明", "变更记录"],
      "properties": {
        "文档名称": { "type": "string", "minLength": 1 },
        "版本": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" },
        "发布日期": { "$ref": "#/definitions/date" },
        "适用人群": { "type": "string", "minLength": 1 },
        "schema_ref": { "type": "string", "minLength": 1 },
        "说明": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "变更记录": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["version", "date", "summary"],
            "properties": {
              "version": { "type": "string" },
              "date": { "$ref": "#/definitions/date" },
              "summary": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "治理配置": {
      "type": "object",
      "required": ["发布状态枚举", "数据状态枚举", "数据更新周期", "审核要求"],
      "properties": {
        "发布状态枚举": {
          "type": "array",
          "items": { "enum": ["draft", "reviewed", "published", "deprecated"] },
          "minItems": 4
        },
        "数据状态枚举": {
          "type": "array",
          "items": { "enum": ["not_collected", "in_progress", "verified", "confirmed_empty"] },
          "minItems": 4
        },
        "数据更新周期": { "type": "string", "minLength": 1 },
        "审核要求": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "枚举字典": {
      "type": "object",
      "required": ["公司层级", "评分范围", "置信度范围", "关键城市"],
      "properties": {
        "公司层级": {
          "type": "array",
          "items": { "enum": ["t1_head", "t2_strong", "t3_regional", "public_sector"] },
          "minItems": 4
        },
        "评分范围": { "type": "string" },
        "置信度范围": { "type": "string" },
        "关键城市": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["city_id", "city_name"],
            "properties": {
              "city_id": { "type": "string", "pattern": "^CITY_\\d{3}$" },
              "city_name": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "来源注册表": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/sourceRegistryItem" }
    },
    "行业索引": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "industry_id", "slug", "行业名称", "status"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "industry_id": { "$ref": "#/definitions/industryId" },
          "slug": { "$ref": "#/definitions/slug" },
          "行业名称": { "type": "string", "minLength": 1 },
          "status": { "enum": ["draft", "reviewed", "published", "deprecated"] },
          "quality_score_overall": { "type": "number", "minimum": 0, "maximum": 100 },
          "ranking_percentile": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "additionalProperties": false
      }
    },
    "行业词条": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/industryEntry" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "nullableDate": {
      "anyOf": [
        { "$ref": "#/definitions/date" },
        { "type": "null" }
      ]
    },
    "industryId": {
      "type": "string",
      "pattern": "^IND_[A-Z0-9_]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceRegistryItem": {
      "type": "object",
      "required": [
        "source_id",
        "source_name",
        "source_type",
        "source_url",
        "credibility",
        "typical_update_cycle",
        "last_checked"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^SRC_[A-Z0-9_]+$" },
        "source_name": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "credibility": { "enum": ["high", "medium", "low"] },
        "typical_update_cycle": { "type": "string", "minLength": 1 },
        "last_checked": { "$ref": "#/definitions/date" },
        "snapshot_url": { "type": "string", "format": "uri" },
        "accessed_at": { "$ref": "#/definitions/date" },
        "http_status": { "type": ["integer", "null"], "minimum": 0, "maximum": 599 },
        "access_check": { "enum": ["checked", "unchecked"] },
        "manual_verification_required": { "type": "boolean" },
        "manual_verification_note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": ["not_collected", "in_progress", "verified", "confirmed_empty"]
    },
    "dynamicCollection": {
      "type": "object",
      "required": ["data_status", "coverage_percent"],
      "properties": {
        "data_status": { "$ref": "#/definitions/status" },
        "coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "updated_at": { "$ref": "#/definitions/nullableDate" },
        "notes": { "type": "string" },
        "items": { "type": "array" },
        "payload": { "type": ["object", "array", "string", "number", "boolean", "null"] },
        "schema_hint": { "type": "object" },
        "collection_tasks": { "type": "array" },
        "estimated_items": { "type": "array" },
        "estimate_items": { "type": "array" },
        "observed_items": { "type": "array" },
        "observed_status": { "enum": ["not_collected", "in_progress", "verified", "confirmed_empty"] },
        "observed_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "observed_requirements": { "type": "object" },
        "official_benchmark": { "type": "array" },
        "data_layers_summary": { "type": "object" },
        "collection_id": { "type": "string", "minLength": 1 },
        "collection_version": { "type": "string", "minLength": 1 },
        "collection_semantics": { "type": "string", "minLength": 1 },
        "linked_macro_collection": { "type": "string", "minLength": 1 },
        "manual_fill_required": { "type": "boolean" },
        "manual_fill_slots": { "type": "array" },
        "manual_fill_progress": { "type": "object" },
        "manual_verification_required": { "type": "boolean" },
        "manual_verification_note": { "type": "string" },
        "last_checked": { "$ref": "#/definitions/nullableDate" },
        "stale_after_days": { "type": "integer", "minimum": 1 },
        "stale_on": { "$ref": "#/definitions/nullableDate" },
        "stale_status": { "enum": ["fresh", "stale"] },
        "min_sample_size_for_verified": { "type": "integer", "minimum": 0 },
        "real_data_ratio_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "template_data_ratio_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "quality": {
          "type": "object",
          "required": ["quantity_score", "evidence_completeness_percent", "freshness_score", "realness_score", "quality_score", "calculated_at"],
          "properties": {
            "quantity_score": { "type": "number", "minimum": 0, "maximum": 100 },
            "evidence_completeness_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "freshness_score": { "type": "number", "minimum": 0, "maximum": 100 },
            "realness_score": { "type": "number", "minimum": 0, "maximum": 100 },
            "source_access_score": { "type": "number", "minimum": 0, "maximum": 100 },
            "manual_gap_penalty": { "type": "number", "minimum": 0, "maximum": 100 },
            "quality_score": { "type": "number", "minimum": 0, "maximum": 100 },
            "calculated_at": { "$ref": "#/definitions/date" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scoreBlock": {
      "type": "object",
      "required": [
        "薪资潜力_1to5",
        "上岸难度_1to5",
        "工作强度_1to5",
        "稳定性_1to5",
        "成长性_1to5",
        "评分口径",
        "置信度"
      ],
      "properties": {
        "薪资潜力_1to5": { "type": "integer", "minimum": 1, "maximum": 5 },
        "上岸难度_1to5": { "type": "integer", "minimum": 1, "maximum": 5 },
        "工作强度_1to5": { "type": "integer", "minimum": 1, "maximum": 5 },
        "稳定性_1to5": { "type": "integer", "minimum": 1, "maximum": 5 },
        "成长性_1to5": { "type": "integer", "minimum": 1, "maximum": 5 },
        "评分口径": { "type": "string", "minLength": 1 },
        "置信度": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "industryMeta": {
      "type": "object",
      "required": [
        "content_version",
        "data_version",
        "status",
        "owner",
        "reviewer",
        "last_updated",
        "next_review_at",
        "data_cycle",
        "state_history"
      ],
      "properties": {
        "content_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "data_version": { "type": "string", "pattern": "^\\d{4}Q[1-4]$" },
        "status": { "enum": ["draft", "reviewed", "published", "deprecated"] },
        "owner": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "last_updated": { "$ref": "#/definitions/date" },
        "next_review_at": { "$ref": "#/definitions/date" },
        "data_cycle": { "type": "string", "minLength": 1 },
        "status_reason": { "type": "string", "minLength": 1 },
        "data_freshness": {
          "type": "object",
          "required": ["last_full_refresh_at", "stale_after_days", "stale_on", "freshness_status"],
          "properties": {
            "last_full_refresh_at": { "$ref": "#/definitions/date" },
            "stale_after_days": { "type": "integer", "minimum": 1 },
            "stale_on": { "$ref": "#/definitions/date" },
            "freshness_status": { "enum": ["fresh", "stale"] }
          },
          "additionalProperties": false
        },
        "state_history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["date", "from", "to", "reason"],
            "properties": {
              "date": { "$ref": "#/definitions/date" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": [
        "todo_collections",
        "in_progress_collections",
        "verified_collections",
        "confirmed_empty_collections",
        "tracked_collections",
        "coverage_percent_overall",
        "evidence_percent_overall",
        "freshness_percent_overall",
        "quality_score_overall",
        "verified_ratio_percent",
        "updated_at"
      ],
      "properties": {
        "todo_collections": { "type": "integer", "minimum": 0 },
        "in_progress_collections": { "type": "integer", "minimum": 0 },
        "verified_collections": { "type": "integer", "minimum": 0 },
        "confirmed_empty_collections": { "type": "integer", "minimum": 0 },
        "tracked_collections": { "type": "integer", "minimum": 0 },
        "coverage_percent_overall": { "type": "number", "minimum": 0, "maximum": 100 },
        "evidence_percent_overall": { "type": "number", "minimum": 0, "maximum": 100 },
        "freshness_percent_overall": { "type": "number", "minimum": 0, "maximum": 100 },
        "real_data_ratio_overall": { "type": "number", "minimum": 0, "maximum": 100 },
        "template_ratio_overall": { "type": "number", "minimum": 0, "maximum": 100 },
        "quality_score_overall": { "type": "number", "minimum": 0, "maximum": 100 },
        "verified_ratio_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "ranking_percentile": { "type": "number", "minimum": 0, "maximum": 100 },
        "weakest_collections": { "type": "array", "items": { "type": "string" } },
        "manual_fill_required_total": { "type": "integer", "minimum": 0 },
        "manual_fill_pending_total": { "type": "integer", "minimum": 0 },
        "manual_fill_completion_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "salary_micro_status": { "enum": ["not_collected", "in_progress", "verified", "confirmed_empty"] },
        "salary_macro_status": { "enum": ["not_collected", "in_progress", "verified", "confirmed_empty"] },
        "updated_at": { "$ref": "#/definitions/date" }
      },
      "additionalProperties": false
    },
    "sourceRecord": {
      "type": "object",
      "required": ["source_id", "source_name", "source_type", "source_url", "source_date", "confidence", "usage"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^SRC_[A-Z0-9_]+$" },
        "source_name": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "source_date": { "$ref": "#/definitions/date" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "usage": { "type": "string", "minLength": 1 },
        "snapshot_url": { "type": "string", "format": "uri" },
        "accessed_at": { "$ref": "#/definitions/date" },
        "http_status": { "type": ["integer", "null"], "minimum": 0, "maximum": 599 },
        "access_check": { "enum": ["checked", "unchecked"] },
        "manual_verification_required": { "type": "boolean" },
        "manual_verification_note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "industryEntry": {
      "type": "object",
      "required": [
        "industry_id",
        "slug",
        "行业名称",
        "meta",
        "static",
        "dynamic",
        "progress",
        "sources"
      ],
      "properties": {
        "industry_id": { "$ref": "#/definitions/industryId" },
        "slug": { "$ref": "#/definitions/slug" },
        "行业名称": { "type": "string", "minLength": 1 },
        "meta": { "$ref": "#/definitions/industryMeta" },
        "static": {
          "type": "object",
          "required": ["基础认知", "就业画像", "招聘与成长", "决策输出", "横向比较评分", "参考方向标签"],
          "properties": {
            "基础认知": { "type": "object" },
            "就业画像": { "type": "object" },
            "招聘与成长": { "type": "object" },
            "决策输出": {
              "type": "object",
              "required": ["推荐人群", "不推荐人群", "替代行业", "转岗路径"],
              "properties": {
                "推荐人群": { "type": "array", "items": { "type": "string" } },
                "不推荐人群": { "type": "array", "items": { "type": "string" } },
                "替代行业": { "type": "array", "items": { "type": "string" } },
                "转岗路径": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": true
            },
            "横向比较评分": { "$ref": "#/definitions/scoreBlock" },
            "参考方向标签": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "dynamic": {
          "type": "object",
          "required": [
            "公司清单",
            "岗位画像库",
            "年度校招时间线",
            "薪酬快照_按城市_按公司层级_按岗位",
            "薪酬实证_国家统计口径"
          ],
          "properties": {
            "公司清单": { "$ref": "#/definitions/dynamicCollection" },
            "岗位画像库": { "$ref": "#/definitions/dynamicCollection" },
            "年度校招时间线": { "$ref": "#/definitions/dynamicCollection" },
            "薪酬快照_按城市_按公司层级_按岗位": { "$ref": "#/definitions/dynamicCollection" },
            "薪酬实证_国家统计口径": { "$ref": "#/definitions/dynamicCollection" },
            "笔试真题库": { "$ref": "#/definitions/dynamicCollection" },
            "面试真题库": { "$ref": "#/definitions/dynamicCollection" },
            "政策变化日志": { "$ref": "#/definitions/dynamicCollection" },
            "行业事件日志": { "$ref": "#/definitions/dynamicCollection" },
            "从业者访谈": { "$ref": "#/definitions/dynamicCollection" },
            "案例复盘": { "$ref": "#/definitions/dynamicCollection" },
            "争议问题与结论": { "$ref": "#/definitions/dynamicCollection" },
            "外部链接": { "$ref": "#/definitions/dynamicCollection" },
            "自定义扩展": { "$ref": "#/definitions/dynamicCollection" }
          },
          "additionalProperties": false
        },
        "progress": { "$ref": "#/definitions/progress" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/sourceRecord" }
        }
      },
      "additionalProperties": false
    }
  }
}
